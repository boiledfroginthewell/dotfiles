#!/usr/bin/env bash
set -eu -o pipefail

while IFS= read -r line; do
	emoji="　"
	if [[ "$line" == *.sh ]]; then
		emoji="🐚"
	elif [[ "$line" == *.fish ]]; then
		emoji="🐟"
	elif [[ "$line" == *.lua ]]; then
		emoji="󰢱"
	elif [[ "$line" == *.vim ]]; then
		emoji=""
	elif [[ "$line" == *.py ]] || [[ "$line" == *py.typed ]]; then
		emoji=""
	elif [[ "$line" =~ \.(js|ts)x?$ ]] || [[ "$line" == *.mjs ]]; then
		emoji=""
	elif [[ "$line" == *.java ]]; then
		emoji="☕"
	elif [[ "$line" == *.cql ]]; then
		emoji="👁️"
	elif [[ "$line" == *.wasm ]]; then
		emoji=""
	elif [[ "$line" =~ \.[shc]ql$ ]]; then
		emoji="🛢️"
	elif [[ "$line" =~ \.(txt|md)$ ]] || [[ "$line" == *"README" ]]; then
		emoji="📝"
	elif [[ "$line" == *.json ]]; then
		# emji ﬥ
		emoji=""
	elif [[ "$line" == *.xml ]]; then
		# emoji 
		emoji="󰗀"
	elif [[ "$line" == *.html ]]; then
		emoji=""
	elif [[ "$line" == *.css ]]; then
		emoji=""
	elif [[ "$line" == *.jinja ]]; then
		emoji=""
	elif [[ "$line" =~ \.(ya?ml|toml|ini|properties|conf)$ ]]; then
		emoji="⚙️"
	elif [[ "$line" =~ .*\.env(\.|$) ]]; then
		emoji="⚙️"
	elif [[ "$line" =~ \.(exe|ps1|bat)$ ]]; then
		emoji=""
	elif [[ "$line" =~ \.[ct]sv$ ]]; then
		emoji=""
	elif [[ "$line" =~ \.tf$ ]]; then
		emoji="󱁢"
	elif [[ "$line" =~ \.(key|pem)$ ]]; then
		emoji="🔑"
	elif [[ "$line" =~ \.(png|jpg|gif|svg)$ ]]; then
		emoji=""
	elif [[ "$line" =~ \.(pu)$ ]]; then
		emoji=""
	elif [[ "$line" == *.groovy ]]; then
		emoji="󰧭"
	elif [[ "$line" =~ \.(gradle)$|gradlew$ ]]; then
		emoji=""
	elif [[ "$line" =~ git ]]; then
		# emoji ""
		emoji=""
	elif [[ "$line" =~ [Dd][Oo][Cc][Kk][Ee][Rr] ]]; then
		emoji="🐋"
	elif [[ "$line" =~ [Aa][Ww][Ss] ]]; then
		emoji=""
	elif [[ "$line" == *.lock ]]; then
		emoji=""
	elif [[ "$line" == */opt/* ]]; then
		emoji="🤖"
	elif [[ "$line" =~ /(\.?config|dotfiles) ]]; then
		emoji="⚙️"
	elif [[ "$line" =~ \.(patch|diff)$ ]]; then
		emoji=""
	elif [[ "$line" == *Makefile ]]; then
		emoji=""
	elif [[ "$line" == *LICENSE ]]; then
		emoji="󰿃"
	elif [[ "$line" == */ ]]; then
		emoji=""
	fi
	echo "$emoji $line"
done
