{
  "title": "Multi-purpose Modifiers",
  "rules": [
    {
      "description": "Shift + Eisuu",
      "manipulators": [
        {
          "from": {
            "key_code": "keypad_2",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_shift"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "japanese_eisuu"
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "ctrl + kana",
      "manipulators": [
        {
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_control"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "japanese_kana"
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
